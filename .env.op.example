# Modelo de referências 1Password. Nunca inclua plaintext.
# Copie para .env.op local e substitua apenas os placeholders de vault/item/campo.
OPENROUTER_API_KEY=op://<vault>/<openrouter-item>/<api-key-field>
HEYGEN_API_KEY=op://<vault>/<heygen-item>/<api-key-field>
REPLICATE_API_TOKEN=op://<vault>/<replicate-item>/<api-token-field>
APIFY_API_TOKEN=op://<vault>/<apify-item>/<api-token-field>
TELEGRAM_BOT_TOKEN=op://<vault>/<telegram-item>/<bot-token-field>
ZAPI_TOKEN=op://<vault>/<zapi-item>/<token-field>
ZAPI_CLIENT_TOKEN=op://<vault>/<zapi-item>/<client-token-field>
META_ACCESS_TOKEN=op://<vault>/<meta-item>/<access-token-field>
FB_ACCESS_TOKEN_PERMANENTE=op://<vault>/<meta-item>/<access-token-field>
FB_ACCESS_TOKEN_TEMPORARIO=op://<vault>/<meta-item>/<access-token-field>
META_PIXEL_CAPI_TOKEN=op://<vault>/<meta-pixel-item>/<capi-token-field>
META_PIXEL_TEST_EVENT_CODE=op://<vault>/<meta-pixel-item>/<test-event-code-field>
VERCEL_TOKEN=op://<vault>/<vercel-item>/<token-field>
FREEPIK_API_KEY=op://<vault>/<freepik-item>/<api-key-field>
GOOGLE_ADS_DEVELOPER_TOKEN=op://<vault>/<google-ads-item>/<developer-token-field>
HOTMART_TOKEN=op://<vault>/<hotmart-item>/<token-field>
WHATSAPP_ACCESS_TOKEN=op://<vault>/<whatsapp-item>/<access-token-field>
GEMINI_API_KEY=op://<vault>/<gemini-item>/<api-key-field>
# LEGACY_ALIAS: use the canonical Meta reference temporarily; map in a future adapter.
ACCESS_TOKEN=op://<vault>/<meta-item>/<access-token-field>
