{
  "permissions": {
    "allow": [
      "Write(meus-produtos/**)",
      "Read(.claude/commands/**)",
      "Read(.claude/agents/**)",
      "Read(.claude/skills/**)",
      "Read(.claude/hooks/**)",
      "Read(.cursor/rules/**)",
      "Read(.github/**)",
      "Read(assets/**)",
      "Read(painel/**)",
      "Read(scripts/**)",
      "Read(meus-produtos/**)",
      "Read(AGENTS.md)",
      "Read(ARQUITETURA.md)",
      "Read(CLAUDE.md)",
      "Read(COMO-USAR.md)",
      "Read(README.md)",
      "Read(.env.example)",
      "Read(package.json)",
      "Read(vercel.json)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/copy-review.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/painel-validar.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Agent|Task|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/agent-status-writer.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/no-emdash-guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
